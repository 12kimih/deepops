      "targets": [
        {
          "expr": "max by (device) (rate(node_disk_read_bytes_total{instance=\"$node_instance\"}[$__rate_interval]))",
          "legendFormat": "Read {{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "max by (device) (rate(node_disk_written_bytes_total{instance=\"$node_instance\"}[$__rate_interval]))",
          "legendFormat": "Write {{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "id": 6
