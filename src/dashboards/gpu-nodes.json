{
  "uid": "gpu-nodes",
  "title": "GPU / Nodes",
  "id": null,
  "description": "One GPU node: GPUs (DCGM), host resources (node-exporter) and system power (BMC).",
  "tags": [
    "gpu",
    "dcgm"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "hostname",
        "label": "server",
        "type": "query",
        "datasource": "$datasource",
        "query": "query_result(label_replace(DCGM_FI_DEV_POWER_USAGE{kubernetes_node!=\"\"}, \"hostname\", \"$1\", \"kubernetes_node\", \"(.+)\") or label_replace(DCGM_FI_DEV_POWER_USAGE{kubernetes_node=\"\",instance=~\".*:9400\"}, \"hostname\", \"$1\", \"instance\", \"(.*):9400\"))",
        "regex": "/hostname=\"([^\"]+)\"/",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {},
        "skipUrlSync": false
      },
      {
        "name": "gpu_instance",
        "label": null,
        "type": "query",
        "datasource": "$datasource",
        "query": "query_result(DCGM_FI_DEV_POWER_USAGE{kubernetes_node=\"$hostname\"} or DCGM_FI_DEV_POWER_USAGE{kubernetes_node=\"\",instance=\"$hostname:9400\"})",
        "regex": "/instance=\"([^\"]+)\"/",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {},
        "skipUrlSync": true
      },
      {
        "name": "node_instance",
        "label": null,
        "type": "query",
        "datasource": "$datasource",
        "query": "query_result(node_uname_info{nodename=\"$hostname\"} or node_uname_info{instance=\"$hostname:9100\"})",
        "regex": "/instance=\"([^\"]+)\"/",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {},
        "skipUrlSync": true
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "$hostname",
      "collapsed": false,
      "panels": [],
      "repeat": "hostname",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "System Load",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(node_load1{instance=\"$node_instance\"})",
          "legendFormat": "1m",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "max(node_load5{instance=\"$node_instance\"})",
          "legendFormat": "5m",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "max(node_load15{instance=\"$node_instance\"})",
          "legendFormat": "15m",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "System Memory",
      "description": "As free(1) splits it: the four add up to the total.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(node_memory_MemTotal_bytes{instance=\"$node_instance\"} - node_memory_MemFree_bytes{instance=\"$node_instance\"} - node_memory_Buffers_bytes{instance=\"$node_instance\"} - node_memory_Cached_bytes{instance=\"$node_instance\"} - node_memory_SReclaimable_bytes{instance=\"$node_instance\"})",
          "legendFormat": "Used",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "max(node_memory_Shmem_bytes{instance=\"$node_instance\"})",
          "legendFormat": "Shared (tmpfs, /dev/shm)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "max(node_memory_Buffers_bytes{instance=\"$node_instance\"} + node_memory_Cached_bytes{instance=\"$node_instance\"} + node_memory_SReclaimable_bytes{instance=\"$node_instance\"} - node_memory_Shmem_bytes{instance=\"$node_instance\"})",
          "legendFormat": "Cache",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        },
        {
          "expr": "max(node_memory_MemFree_bytes{instance=\"$node_instance\"})",
          "legendFormat": "Free",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Disk Usage",
      "description": "Local file systems (network and in-memory ones left out).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "expr": "1 - sum(max by (device) (node_filesystem_avail_bytes{instance=\"$node_instance\",fstype!~\"tmpfs|ramfs|overlay|squashfs|nfs.*|cifs|fuse.*|autofs\"})) / sum(max by (device) (node_filesystem_size_bytes{instance=\"$node_instance\",fstype!~\"tmpfs|ramfs|overlay|squashfs|nfs.*|cifs|fuse.*|autofs\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 3,
        "h": 5
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Memory Used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
