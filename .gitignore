# ansible
*.retry

# ansible run logs (keep the logs/ dir via .gitkeep, ignore the logs themselves)
*.log
/logs/*
!/logs/.gitkeep

# misc.
.*.swp

# virtualenv
/.venv/
/.venv-kubespray/

# ansible-lint / ansible runtime cache
/.ansible/

# python bytecode
__pycache__/
*.py[cod]

# local, untracked notes
/CLAUDE.md
/tasks/

# project-specific
/admin.conf
/config*/
!/config.example/
# Installed by scripts/deepops/galaxy.py (.*.new and .*.old only while it runs; no
# trailing slash, so a symlink there is ignored too: git sees a link as a file)
/roles/galaxy
/roles/.galaxy.*
/collections
/.collections.*
/.galaxy.lock
/k8s-config/
# The same names as links (a scratch worktree links them to a full clone): a pattern
# ending in / matches only a directory, so `git add -A` would stage the link itself.
/.venv
/.venv-kubespray
/config
/roles/galaxy
/collections
/kubectl
/tridentctl

# secrets -- never commit (Ansible Vault password files, plaintext creds)
.vault-pass
*.vault-pass
vault-password*
