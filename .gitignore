# ansible
*.retry

# ansible run logs (keep the logs/ dir via .gitkeep, ignore the logs themselves)
*.log
/logs/*
!/logs/.gitkeep

# misc.
.*.swp

# virtualenv
/.venv/
/.venv-kubespray/

# ansible-lint / ansible runtime cache
/.ansible/

# python bytecode
__pycache__/
*.py[cod]

# local, untracked notes
/CLAUDE.md
/tasks/

# project-specific
/admin.conf
/config*/
!/config.example/
# Installed by scripts/deepops/galaxy.py (.*.new and .*.old only while it runs)
/roles/galaxy/
/roles/.galaxy.*/
/collections/
/.collections.*/
/k8s-config/
/kubectl
/tridentctl

# secrets -- never commit (Ansible Vault password files, plaintext creds)
.vault-pass
*.vault-pass
vault-password*
