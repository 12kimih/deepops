Name: New SSH sessions per person on a login node (roles/ssh_rate)
Default: no
Priority: 0
Account-Type: Additional
Account:
	[success=ok default=bad]	pam_exec.so quiet stdout /bin/sh -c [test -x {{ _ssh_rate_gate }} || exit 0; exec {{ _ssh_rate_gate }} account]
Session-Interactive-Only: yes
Session-Type: Additional
Session:
	optional	pam_exec.so quiet type=open_session /bin/sh -c [test -x {{ _ssh_rate_gate }} || exit 0; exec {{ _ssh_rate_gate }} session]
