{{ ansible_managed | comment }}
# roles/scratch_alloc
[Unit]
Description=Keep the scratch allocations' end dates and export their usage

[Service]
Type=oneshot
TimeoutStartSec=2h
# The directory may sit on /run, which is empty after a boot.
ExecStartPre=/usr/bin/install -d -m 0755 {{ node_exporter_prom_dir }}
ExecStart={{ _scratch_alloc_command }} {{ _scratch_alloc_config }} sweep
ExecStart={{ _scratch_alloc_command }} {{ _scratch_alloc_config }} metrics
Nice=10
IOSchedulingClass=idle
