#!/bin/sh
# Managed by roles/bmc (bmc_cold_reboot). systemd-shutdown runs this last, the root
# filesystem read-only, with the verb: reboot, poweroff, halt or kexec. On a reboot it
# asks this host's own BMC, in-band (the IPMI device, no password), to power-cycle the
# chassis: this host's hardware comes back whole only from a cold start. Every clean
# reboot is covered (Slurm's RebootProgram, the maintenance playbooks, a plain reboot);
# a kernel panic's restart is not. If the BMC does not answer, the warm reboot goes on
# and NHC drains the node for its missing devices.
log() { echo "bmc-cold-reboot: $*" 2>/dev/null >/dev/kmsg || true; }
[ "$1" = reboot ] || exit 0
[ -c "${BMC_COLD_REBOOT_DEVICE:-/dev/ipmi0}" ] || exit 0
if ! timeout 20 ipmitool -I open chassis power cycle; then
    log "the BMC did not answer; this stays a warm reboot"
    exit 0
fi
log "the BMC power-cycles the chassis"
# The BMC cuts the power within seconds; the warm reboot waits for it until then.
sleep "${BMC_COLD_REBOOT_WAIT:-60}"
