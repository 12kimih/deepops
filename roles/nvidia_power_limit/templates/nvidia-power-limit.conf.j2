# {{ ansible_managed }}
# deepops nvidia_power_limit role -- the GPU power cap enforced on this node, in watts.
#
# Read as an EnvironmentFile by {{ nvidia_power_limit_service_name }} and by the power
# policy (cluster_tools.power_policy), which holds every GPU at it: one number for both.
# Change it from config/ and re-run the role; editing it here is undone by the next run.
NVIDIA_POWER_LIMIT_WATTS={{ nvidia_power_limit_target | int }}
