# {{ ansible_managed }}
# deepops nvidia_power_limit role -- pin the GPU power cap across reboots.
#
# nvidia-smi resets the power limit to the card default on every boot / driver reload,
# so this oneshot unit re-applies it at boot: after the persistence daemon (roles/
# nvidia_driver) keeps the driver initialized, and before slurmd, so no job starts on
# an uncapped GPU. RemainAfterExit=yes so the unit shows
# "active" after the cap is set (the process itself exits immediately), which lets a
# `systemctl restart` re-apply a changed value.
#
# The wattage comes from the EnvironmentFile rather than being baked in here, so the node
# holds one copy of it and the Slurm prolog/epilog helper can read the same number.
[Unit]
Description=Set the NVIDIA GPU power limit (deepops)
After=nvidia-persistenced.service
# The cap goes with the GPUs' initialization: a restarted persistence daemon brings them
# back at their default limit, so this unit restarts with it and sets the cap again.
PartOf=nvidia-persistenced.service
Before=slurmd.service
ConditionPathExists={{ nvidia_power_limit_conf_file }}

[Service]
Type=oneshot
RemainAfterExit=yes
# A oneshot has no start timeout by default; a hung nvidia-smi would hold up boot.
TimeoutStartSec=5min
EnvironmentFile={{ nvidia_power_limit_conf_file }}
ExecStart=/usr/bin/nvidia-smi -pl ${NVIDIA_POWER_LIMIT_WATTS}

[Install]
WantedBy=multi-user.target
