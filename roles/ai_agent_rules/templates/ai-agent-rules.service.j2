{{ ansible_managed | comment }}
[Unit]
Description=Refresh the AI agent rules from the site docs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart={{ ai_agent_rules_command }} --url {{ ai_agent_rules_url | quote }} --claude {{ ai_agent_rules_claude_file }} --codex {{ ai_agent_rules_codex_file }}
ProtectSystem=full
ReadWritePaths={{ ai_agent_rules_claude_file | dirname }} {{ ai_agent_rules_codex_file | dirname }}
PrivateTmp=true
NoNewPrivileges=true
