#!/bin/sh
# orphan-services [PROC]: print "UNIT PATH" for each system service whose main process
# runs a program that is no longer on disk.
#
# Removing a package stops the units it ships, but not a daemon started another way
# (an init script, by hand): it keeps running from the deleted file, still listening.
# Only a unit's MAIN process counts: a session or job process inside ssh, cron or
# slurmd that runs a deleted file says nothing about the daemon, and stopping that unit
# would cut off logins or jobs. An upgraded daemon shows "(deleted)" too, but its path
# exists again (the new file), so it is left alone.
proc=${1:-/proc}
systemctl=${SYSTEMCTL:-systemctl}
for p in "$proc"/[0-9]*; do
    exe=$(readlink "$p/exe" 2>/dev/null) || continue
    case $exe in
        *" (deleted)") path=${exe% (deleted)} ;;
        *) continue ;;
    esac
    [ -e "$path" ] && continue
    unit=$(sed -n 's|^[0-9]*:[^:]*:/system\.slice/\([^/]*\.service\)$|\1|p' "$p/cgroup" 2>/dev/null | head -n 1)
    [ -n "$unit" ] || continue
    [ "$("$systemctl" show -P MainPID "$unit" 2>/dev/null)" = "${p##*/}" ] || continue
    printf '%s %s\n' "$unit" "$path"
done | sort -u
