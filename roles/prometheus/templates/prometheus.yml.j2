{{ ansible_managed | comment }}
global:
  scrape_interval: {{ prometheus_cfg_scrape_interval }}
  evaluation_interval: {{ prometheus_cfg_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:{{ alertmanager_port | default(9093) }}']

rule_files:
  - rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']
        labels: {host: '{{ inventory_hostname }}'}
  - job_name: alertmanager
    static_configs:
      - targets: ['localhost:{{ alertmanager_port | default(9093) }}']
        labels: {host: '{{ inventory_hostname }}'}
  - job_name: cluster
    file_sd_configs:
      - files:
          - {{ prometheus_cfg_endpoint_dir }}/*.yml
    relabel_configs:
      # host=<name> without the port, so alerts and queries join exporters.
      - source_labels: [__address__]
        regex: '(.+):\d+'
        target_label: host
