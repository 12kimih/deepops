{{ ansible_managed | comment }}
global:
  scrape_interval: {{ prometheus_cfg_scrape_interval }}
  evaluation_interval: {{ prometheus_cfg_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:{{ alertmanager_port }}']

rule_files:
  - rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']
        labels: {host: '{{ inventory_hostname }}', module: prometheus}
  - job_name: alertmanager
    static_configs:
      - targets: ['localhost:{{ alertmanager_port }}']
        labels: {host: '{{ inventory_hostname }}', module: alertmanager}
{% for set in prometheus_slurmctld_metrics if prometheus_slurmctld_targets | length > 0 %}
  - job_name: slurmctld-{{ set }}
    metrics_path: /metrics/{{ set }}
    static_configs:
      - targets: {{ prometheus_slurmctld_targets | to_json }}
        labels: {module: slurmctld}
    relabel_configs:
      - source_labels: [__address__]
        regex: '(.+):\d+'
        target_label: host
{% endfor %}
  - job_name: cluster
    file_sd_configs:
      - files:
          - {{ prometheus_cfg_endpoint_dir }}/*.yml
    relabel_configs:
      # host=<name> without the port, so alerts and queries join exporters.
      - source_labels: [__address__]
        regex: '(.+):\d+'
        target_label: host
    metric_relabel_configs:
      # node_exporter's mountstats: the per-mount byte and page counters stay; its 44
      # per-operation, transport and event families per mount are dropped.
      - source_labels: [__name__]
        regex: 'node_mountstats_nfs_(operations|transport|event)_.+'
        action: drop
      # Its mountpoint as the host names it: the exporter's container sees the host's
      # mounts under node_exporter_rootfs.
      - source_labels: [__name__, mountpoint]
        regex: 'node_mountstats_nfs_mountpoint_info;{{ node_exporter_rootfs | regex_escape }}(/.*)'
        target_label: mountpoint
        replacement: '$1'
