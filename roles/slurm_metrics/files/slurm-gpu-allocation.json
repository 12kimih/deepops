{
  "uid": "slurm-gpu-allocation",
  "title": "Slurm / GPU allocation",
  "id": null,
  "description": "Who holds which GPU: Slurm allocation (roles/slurm_metrics) against usable capacity, joined with DCGM utilisation.",
  "tags": [
    "slurm",
    "gpu"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "GPUs",
      "description": "GPUs Slurm has configured (gres).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(max by (node, gpu_type) (slurm_node_gpus))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Usable",
      "description": "GPUs on nodes where new jobs can start (not drained or down).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "text",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(max by (node, gpu_type) (slurm_node_gpus) * on (node) group_left () max by (node) (slurm_node_schedulable))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Allocated",
      "description": "GPUs held by running jobs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "(count(host_device:slurm_gpu_allocated:max) or vector(0))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Allocated of usable",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "noValue": "No usable GPU"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "(count(host_device:slurm_gpu_allocated:max) or vector(0)) / sum(max by (node, gpu_type) (slurm_node_gpus) * on (node) group_left () max by (node) (slurm_node_schedulable))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Users",
      "description": "Users holding GPUs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "count(count by (user) (host_device:slurm_gpu_allocated:max)) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Busy without a job",
      "description": "GPUs in use that no Slurm job holds (alert GpuBusyWithoutJob, pending or firing).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=\"GpuBusyWithoutJob\"}) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Capacity and allocation",
      "description": "Usable drops when nodes are drained or down; allocation can only use what is usable.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Configured"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Usable"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Allocated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(max by (node, gpu_type) (slurm_node_gpus))",
          "legendFormat": "Configured",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(max by (node, gpu_type) (slurm_node_gpus) * on (node) group_left () max by (node) (slurm_node_schedulable))",
          "legendFormat": "Usable",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "(count(host_device:slurm_gpu_allocated:max) or vector(0))",
          "legendFormat": "Allocated",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 10
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Nodes",
      "description": "Each node's GPUs and Slurm state; no new job starts on a drained or down node.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "None",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "down|fail|error",
                      "result": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "drain",
                      "result": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(idle|mixed|allocated)$",
                      "result": {
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GPUs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "expr": "label_replace((max by (node, gpu_type) (slurm_node_gpus) * on (node) group_left (state) max by (node, state) (slurm_node_state)) and on (node) (max by (node) (slurm_node_drain) == 1), \"state\", \"$1, drain\", \"state\", \"(.+)\") or ((max by (node, gpu_type) (slurm_node_gpus) * on (node) group_left (state) max by (node, state) (slurm_node_state)) unless on (node) (max by (node) (slurm_node_drain) == 1))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "GPUs"
            },
            "indexByName": {
              "node": 0,
              "gpu_type": 1,
              "state": 2,
              "GPUs": 3
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "node",
                "gpu_type",
                "state",
                "GPUs"
              ]
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "node"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 10
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Allocated by user",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0,
          "noValue": "No GPU allocated"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "count by (user) (host_device:slurm_gpu_allocated:max)",
          "legendFormat": "{{user}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Allocated by account",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0,
          "noValue": "No GPU allocated"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "count by (account) (host_device:slurm_gpu_allocated:max)",
          "legendFormat": "{{account}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "id": 10
    },
    {
      "type": "bargauge",
      "title": "Share allocated by GPU type",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 0,
          "displayName": "${__data.fields.gpu_type}",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "targets": [
        {
          "expr": "(sum by (gpu_type) (count by (gpu_type, host, device) (host_device:slurm_gpu_allocated:max)) or 0 * sum by (gpu_type) (max by (node, gpu_type) (slurm_node_gpus))) / sum by (gpu_type) (max by (node, gpu_type) (slurm_node_gpus))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "gpu_type"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "id": 11
    },
    {
      "type": "bargauge",
      "title": "Share allocated by node",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 0,
          "displayName": "${__data.fields.node}",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "targets": [
        {
          "expr": "(sum by (node) (count by (node, host, device) (host_device:slurm_gpu_allocated:max)) or 0 * sum by (node) (max by (node, gpu_type) (slurm_node_gpus))) / sum by (node) (max by (node, gpu_type) (slurm_node_gpus))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "node"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 16,
        "h": 8
      },
      "id": 12
    },
    {
      "type": "table",
      "title": "Allocations now",
      "description": "Each GPU a running job holds, with its current utilisation (DCGM).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No GPU allocated",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Utilization"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-RdYlGr"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "expr": "host_device:slurm_gpu_allocated:max * on (host, device) group_left () host_device:dcgm_gpu_util:max",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "Utilization"
            },
            "indexByName": {
              "user": 0,
