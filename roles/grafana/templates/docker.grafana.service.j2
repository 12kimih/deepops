[Unit]
Description=Grafana
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
PartOf=docker.service

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
ExecStart=/usr/bin/docker run --rm --network host --name %n -v {{ grafana_config_dir }}:/etc/grafana:ro -v {{ grafana_data_dir }}:/var/lib/grafana {{ grafana_container }}

[Install]
WantedBy=multi-user.target
