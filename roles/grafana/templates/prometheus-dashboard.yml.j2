{{ ansible_managed | comment }}
apiVersion: 1

providers:
  - name: deepops
    folder: '{{ grafana_dashboard_folder }}'
    folderUid: '{{ grafana_dashboard_folder_uid }}'
    type: file
    # The files are the source of truth: a dashboard whose file is removed is deleted,
    # and edits in the UI cannot be saved over a provisioned one.
    disableDeletion: false
    allowUiUpdates: false
    options:
      # grafana_dashboards_dir as the container sees it (grafana_config_dir is /etc/grafana there).
      path: /etc/grafana/{{ grafana_dashboards_dir | relpath(grafana_config_dir) }}
