[Unit]
Description=NVIDIA DCGM Exporter
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
PartOf=docker.service

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
# The GPUs come through CDI (the toolkit's generated spec), not --gpus: a container
# given them by the legacy hook loses them on every systemd daemon-reload (NVIDIA's
# troubleshooting guide). Host network: the node's own name labels the series, and no
# Docker DNAT bypasses the host firewall. The collectors file is mounted read-only and
# named, as the exporter's docs show.
ExecStart=/usr/bin/docker run --rm --device nvidia.com/gpu=all --cap-add=SYS_ADMIN --cpus="{{ dcgm_exporter_max_cpu }}" --name %n --network host -v "{{ dcgm_exporter_config_dir }}/{{ dcgm_exporter_counters_file }}:/etc/dcgm-exporter/custom-counters.csv:ro" {{ dcgm_exporter_container }} --collectors /etc/dcgm-exporter/custom-counters.csv --address :{{ dcgm_exporter_port }}

[Install]
WantedBy=multi-user.target
