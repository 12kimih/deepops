# EasyBuild system configuration (roles/easy-build). The build account installs into its
# own prefix; the default robot path is the easyconfigs shipped with EasyBuild.
[config]
prefix = {{ easybuild_prefix }}
installpath-modules = {{ easybuild_module_path | dirname }}
suffix-modules-path = {{ easybuild_module_path | basename }}
buildpath = {{ easybuild_home }}/build
modules-tool = Lmod
module-syntax = Lua

[override]
umask = 022
