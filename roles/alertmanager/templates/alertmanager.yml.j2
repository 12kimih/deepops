{{ ansible_managed | comment }}
global:
  resolve_timeout: 5m
{% if alertmanager_slack_api_url %}
  slack_api_url: '{{ alertmanager_slack_api_url }}'
{% endif %}

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: slack
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: {{ alertmanager_repeat_interval }}
  routes:
    # Heartbeat about once a minute. A repeat is only sent on a group_interval tick
    # once repeat_interval has passed, so 1m/1m lands every second tick (2 minutes);
    # 30s/30s sends on every other 30 s tick, i.e. about every 60 s.
    - matchers: ['alertname="Watchdog"']
      receiver: heartbeat
      group_wait: 0s
      group_interval: 30s
      repeat_interval: 30s
    - matchers: ['severity="critical"']
      receiver: slack-critical
      repeat_interval: {{ alertmanager_critical_repeat_interval }}

inhibit_rules:
  # A dead host explains every other alert on it.
  - source_matchers: ['alertname="HostDown"']
    target_matchers: ['severity=~"warning|critical"']
    equal: [host]
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [alertname, host]

receivers:
  - name: heartbeat
{% if alertmanager_heartbeat_url %}
    webhook_configs:
      - url: '{{ alertmanager_heartbeat_url }}'
        send_resolved: false
{% endif %}
{% for name, mention in [('slack', ''), ('slack-critical', alertmanager_slack_critical_mention)] %}
  - name: {{ name }}
{% if alertmanager_slack_api_url %}
    slack_configs:
      - channel: '{{ alertmanager_slack_channel }}'
        send_resolved: true
{%- raw %}
        color: '{{ template "slack.color" . }}'
        title: '{{ template "slack.title" . }}'
{% endraw %}
{% if alertmanager_dashboard_url %}
        title_link: '{{ alertmanager_dashboard_url }}'
{% endif %}
        footer: 'Alertmanager'
        text: '{% if mention %}{% raw %}{{ if eq .Status "firing" }}{% endraw %}{{ mention }} {% raw %}{{ end }}{% endraw %}{% endif %}{% raw %}{{ template "slack.text" . }}{% endraw %}'
{% endif %}
{% endfor %}
