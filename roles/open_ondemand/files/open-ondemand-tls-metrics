#!/bin/sh
# Managed by DeepOps (roles/open_ondemand).
# Write the portal certificate's expiry as a node_exporter textfile metric.
# Usage: open-ondemand-tls-metrics CERT TEXTFILE_DIR
set -eu
cert=$1
dir=$2
out="$dir/open_ondemand_tls.prom"
tmp="$out.$$"

# An unreadable certificate publishes no expiry: a made-up one would read as expired.
if end=$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null) &&
    not_after=$(date -d "${end#notAfter=}" +%s); then
    cat > "$tmp" <<EOF
# HELP open_ondemand_tls_cert_not_after_seconds Expiry of the Open OnDemand portal certificate (Unix time).
# TYPE open_ondemand_tls_cert_not_after_seconds gauge
open_ondemand_tls_cert_not_after_seconds $not_after
EOF
    ok=1
else
    : > "$tmp"
    ok=0
fi
cat >> "$tmp" <<EOF
# HELP open_ondemand_tls_cert_readable Whether the portal certificate could be read.
# TYPE open_ondemand_tls_cert_readable gauge
open_ondemand_tls_cert_readable $ok
EOF
chmod 0644 "$tmp"
mv "$tmp" "$out"
