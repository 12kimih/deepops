[Unit]
Description=Prometheus IPMI Exporter
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
PartOf=docker.service

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
ExecStart=/usr/bin/docker run --rm --network host --name %n --user 0 \
  --cpus={{ ipmi_exporter_max_cpu }} --device /dev/ipmi0 \
  -v {{ ipmi_exporter_config_dir }}:/config:ro \
  {{ ipmi_exporter_container }} \
  --config.file=/config/config.yml \
  --web.listen-address=:{{ ipmi_exporter_port }}

[Install]
WantedBy=multi-user.target
