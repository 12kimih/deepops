#!/usr/bin/env csh
# Register the module trees (lmod_module_paths, in order) with Lmod via LMOD_SITE_MODULEPATH.
# The distro Lmod init (/etc/profile.d/lmod.csh, from Lmod's profile.in) reads this before
# setting MODULEPATH, prepends it, and preserves it across `module reset`. Sorts before
# lmod.csh (00- prefix). https://lmod.readthedocs.io/en/latest/090_configuring_lmod.html
# The init prepends each entry in turn, so the trees are listed last to first here.
if ( ! $?LMOD_SITE_MODULEPATH ) then
    setenv LMOD_SITE_MODULEPATH "{{ lmod_module_paths | reverse | join(':') }}"
else
    setenv LMOD_SITE_MODULEPATH "{{ lmod_module_paths | reverse | join(':') }}:${LMOD_SITE_MODULEPATH}"
endif
