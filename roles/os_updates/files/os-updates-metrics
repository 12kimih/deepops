#!/bin/sh
# Pending package updates and whether a reboot is needed, as node_exporter textfile
# metrics (roles/os_updates). Simulates the full upgrade the maintenance window runs,
# so held-back packages count too. Also every installed package and its version, so
# Prometheus sees hosts drift apart the day it happens, not at the next maintenance.
#
#   os-updates-metrics <textfile-dir>               measure, keep, publish
#   os-updates-metrics --publish <textfile-dir>     publish the kept files only (at boot)
#   os-updates-metrics --components <textfile-dir>  the component record's series only
#
# The component record's series are a file of their own (os-updates-components.prom):
# the record changes with every deploy, and component_record refreshes them as soon as
# it writes it (os-updates-components.service), without measuring the packages again.
#
# The metrics are kept in /var/lib/os-updates (the textfile directory is usually
# tmpfs and empty after a reboot, and an absent series never alerts), together with
# when security updates were first seen pending, so "pending for N days" survives.
# Whether a reboot is pending is measured afresh on every publish, the boot one too: a
# kept copy from before the reboot would report the reboot it just had as pending.
set -eu
state=${OS_UPDATES_STATE:-/var/lib/os-updates}  # overridable for the tests
mode=measure
case "${1:-}" in
    --publish) mode=publish; shift ;;
    --components) mode=components; shift ;;
esac
dir=${1:?textfile directory}
mkdir -p "$dir" "$state"

now=$(date +%s)

# reboot-required's mtime moves each time a package touches it; the first time it was
# seen is kept instead, on /run like the flag itself, so a reboot clears both.
reboot_flag=${OS_UPDATES_REBOOT_FLAG:-/var/run/reboot-required}  # overridable for the tests
reboot_stamp=${OS_UPDATES_RUN:-/run}/os-updates-reboot-required-since
reboot_state() {
    if [ -f "$reboot_flag" ]; then
        reboot=1
        [ -s "$reboot_stamp" ] || echo "$now" > "$reboot_stamp"
        reboot_since=$(cat "$reboot_stamp")
    else
        reboot=0; reboot_since=0
        rm -f "$reboot_stamp"
    fi
}

# The packages' file first: a kept copy an older version of this command wrote still has
# the component series, and they leave it before their own file brings them back (a
# series in two files makes node_exporter refuse both).
publish() {
    if [ -f "$state/os-updates.prom" ]; then
        reboot_state
        tmp=$(mktemp "$dir/.os-updates.XXXXXX")
        sed -e "s/^os_updates_reboot_required .*/os_updates_reboot_required $reboot/" \
            -e "s/^os_updates_reboot_required_since_seconds .*/os_updates_reboot_required_since_seconds $reboot_since/" \
            "$state/os-updates.prom" > "$tmp"
        chmod 0644 "$tmp"
        mv "$tmp" "$dir/os-updates.prom"
    fi
    if [ -f "$state/os-updates-components.prom" ]; then
        tmp=$(mktemp "$dir/.os-updates-components.XXXXXX")
        cat "$state/os-updates-components.prom" > "$tmp"
        chmod 0644 "$tmp"
        mv "$tmp" "$dir/os-updates-components.prom"
    fi
}

# What deepops installed, from the host's component record (roles/component_record): each
# component's recorded version and source digest, and which component installed each
# package, so an alert on a package or a component names the playbook that brings its
# hosts level. The units name the record (deepops_component_record); none there, no
# series. Kept; publish puts it out.
components() {
    record=${OS_UPDATES_COMPONENT_RECORD:-}
    series=$([ -n "$record" ] && python3 - "$record" 2>/dev/null <<'PY' || true
import json, sys
def esc(s):
    return str(s).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except (OSError, ValueError):
    sys.exit(0)
for name, entry in sorted((data.get("components") or {}).items()):
    if isinstance(entry, dict) and entry.get("state") == "present":
        print(f'os_updates_component_info{{component="{esc(name)}",version="{esc(entry.get("version", ""))}"}} 1')
# one metric's lines together, as the text format requires
sources = {name: entry["source"] for name, entry in (data.get("components") or {}).items()
           if isinstance(entry, dict) and entry.get("state") == "present" and entry.get("source")}
if data.get("record_source"):
    sources["component_record"] = data["record_source"]
for name, source in sorted(sources.items()):
    print(f'os_updates_component_source_info{{component="{esc(name)}",source="{esc(source)}"}} 1')
for item, owners in sorted((data.get("items") or {}).items()):
    kind, _, package = item.partition(":")
    if kind == "package":
        for name in owners:
            print(f'os_updates_package_component_info{{package="{esc(package)}",component="{esc(name)}"}} 1')
PY
)
    tmp=$(mktemp "$state/.os-updates-components.XXXXXX")
    cat > "$tmp" <<METRICS
# HELP os_updates_component_info A component deepops installed and its recorded version (value always 1).
# TYPE os_updates_component_info gauge
# HELP os_updates_component_source_info The source digest a component's last whole deploy recorded (value always 1).
# TYPE os_updates_component_source_info gauge
# HELP os_updates_package_component_info A package and the component that installed it (value always 1).
# TYPE os_updates_package_component_info gauge
$series
METRICS
    mv "$tmp" "$state/os-updates-components.prom"
}

case $mode in
    publish) publish; exit 0 ;;
    components) components; publish; exit 0 ;;
esac

# A package left half-installed or half-configured (an interrupted upgrade) makes
# dpkg refuse every later change, security updates included, without telling anyone.
dpkg_problems=$(dpkg --audit 2>/dev/null | grep -c '^ ' || true)
# If apt cannot simulate the upgrade the counts below mean nothing: report that
# instead of "0 pending".
if sim=$(apt-get -s -q -o Debug::NoLocking=1 dist-upgrade 2>/dev/null); then apt_ok=1; else apt_ok=0; fi
plan=$(printf '%s\n' "$sim" | grep '^Inst ' || true)
all=$(printf '%s\n' "$plan" | grep -c '^Inst ' || true)
security=$(printf '%s\n' "$plan" | grep -c -- '-security' || true)
# The "pending since" clocks move only on what was actually measured: a run where apt
# could not simulate knows nothing about security updates, so it keeps the clock
# rather than resetting it (one transient apt failure would restart the alert's count).
if [ "$apt_ok" = 1 ]; then
    if [ "$security" -gt 0 ]; then
        [ -s "$state/security-pending-since" ] || echo "$now" > "$state/security-pending-since"
    else
        rm -f "$state/security-pending-since"
    fi
fi
security_since=$(cat "$state/security-pending-since" 2>/dev/null || echo 0)
reboot_state
# One series per installed package ("?i": held ones too); label values escaped as the
# format requires. source: "local" when no configured apt source offers the installed
# version (apt list's [installed,local]: a .deb installed by hand or from a URL, which only
# the role that installed it can change), "repo" otherwise.
packages=$( { apt list --installed 2>/dev/null | awk -F/ '/\[installed,local\]/ { print "L|" $1 }'
              dpkg-query -W -f '${db:Status-Abbrev}|${binary:Package}|${Version}\n' 2>/dev/null; } \
    | awk -F'|' '$1 == "L" { local[$2] = 1; next }
        $1 ~ /^.i/ { name = $2; sub(/:.*/, "", name); gsub(/\\/, "\\\\", $3); gsub(/"/, "\\\"", $3);
        printf "os_updates_package_info{package=\"%s\",version=\"%s\",source=\"%s\"} 1\n", $2, $3,
               (name in local) ? "local" : "repo" }')
tmp=$(mktemp "$state/.os-updates.XXXXXX")
cat > "$tmp" <<METRICS
# HELP os_updates_pending_packages Packages a full upgrade would install or change.
# TYPE os_updates_pending_packages gauge
os_updates_pending_packages{kind="all"} $all
os_updates_pending_packages{kind="security"} $security
# HELP os_updates_security_pending_since_seconds When security updates were first seen pending (0 = none).
# TYPE os_updates_security_pending_since_seconds gauge
os_updates_security_pending_since_seconds $security_since
# HELP os_updates_reboot_required Whether an installed update asks for a reboot.
# TYPE os_updates_reboot_required gauge
os_updates_reboot_required $reboot
# HELP os_updates_reboot_required_since_seconds When the reboot was first asked for (0 = not asked).
# TYPE os_updates_reboot_required_since_seconds gauge
os_updates_reboot_required_since_seconds $reboot_since
# HELP os_updates_dpkg_problems Packages dpkg --audit reports half-installed or half-configured.
# TYPE os_updates_dpkg_problems gauge
os_updates_dpkg_problems $dpkg_problems
# HELP os_updates_apt_ok Whether apt could simulate the upgrade (0: the counts above are not valid).
# TYPE os_updates_apt_ok gauge
os_updates_apt_ok $apt_ok
# HELP os_updates_package_info An installed package and its version (value always 1).
# TYPE os_updates_package_info gauge
$packages
# HELP os_updates_metrics_timestamp_seconds When these metrics were measured.
# TYPE os_updates_metrics_timestamp_seconds gauge
os_updates_metrics_timestamp_seconds $now
METRICS
mv "$tmp" "$state/os-updates.prom"
components
publish
