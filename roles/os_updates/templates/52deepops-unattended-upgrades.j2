// Managed by DeepOps (roles/os_updates). Overrides 50unattended-upgrades.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
{% for origin in _os_updates_apt_origins[ansible_distribution] %}
    "{{ origin }}";
{% endfor %}
};

// Upgraded in a maintenance window by the roles that own them (os_updates_held_back).
#clear Unattended-Upgrade::Package-Blacklist;
Unattended-Upgrade::Package-Blacklist {
{% for glob in os_updates_held_back %}
    "^{{ glob.split('*') | map('regex_escape') | join('.*') }}$";
{% endfor %}
};

Unattended-Upgrade::Automatic-Reboot "false";
