# {{ ansible_managed }}
# Lmod modules for what this instance installs, in a Core/compiler/MPI hierarchy; the
# Core layer is registered with Lmod on every node (roles/spack tasks_from: register).
# https://spack.readthedocs.io/en/latest/module_file_support.html
modules:
  default:
    enable:
      - lmod
    arch_folder: false
    roots:
      lmod: {{ (spack_install_dir ~ '/share/spack/lmod') | to_json }}
    lmod:
      core_compilers: {{ spack_lmod_core_compilers | to_json }}
      hierarchy:
        - mpi
