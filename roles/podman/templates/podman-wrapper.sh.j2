#!/bin/sh
# {{ ansible_managed }}
# A Slurm job inherits the login node's XDG_RUNTIME_DIR, which is missing here, and
# podman fails on it. Use the directory roles/podman keeps for this user, so every
# job and session on the node shares one podman state.
runtime="{{ podman_runtime_root }}/$(id -u)"
if [ -d "$runtime" ] && [ -O "$runtime" ]; then
    XDG_RUNTIME_DIR="$runtime"
    export XDG_RUNTIME_DIR
fi
exec /usr/bin/podman "$@"
