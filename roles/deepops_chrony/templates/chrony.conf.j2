# {{ ansible_managed }}
# chrony.conf(5); roles/deepops_chrony.
{% if chrony_config_confdir %}
confdir {{ chrony_config_confdir }}
{% endif %}

{% if chrony_serves %}
{% for source in chrony_upstream %}
{{ source }}
{% endfor %}
{% else %}
# From the cluster's time servers ({{ chrony_serve_hosts | join(', ') }}).
{% for host in chrony_serve_hosts %}
server {{ chrony_serve_addresses[host] or host }} iburst
{% endfor %}
{% endif %}
{% if chrony_config_sourcedir %}
sourcedir {{ chrony_config_sourcedir }}
{% endif %}

keyfile {{ chrony_config_keyfile }}
driftfile {{ chrony_config_driftfile }}
ntsdumpdir {{ chrony_config_ntsdumpdir }}
logdir {{ chrony_config_logdir }}

# Ignore a source whose frequency estimate is too uncertain.
maxupdateskew 100.0
# Copy the system time to the real-time clock every 11 minutes.
rtcsync
# Step the clock (rather than slew it) if it is off by more than a second, in the first
# three updates only; after that a running clock is only slewed.
makestep 1 3
# The leap second table from the time zone database, so leap seconds are handled.
leapsectz right/UTC
# Log a clock adjustment larger than half a second to syslog.
logchange 0.5

# Commands only from this host.
bindcmdaddress 127.0.0.1
bindcmdaddress ::1
{% if chrony_serve_hosts and chrony_serves %}

# Serve the cluster; keep serving at a fixed stratum when every upstream source is lost.
{% for network in chrony_serve_networks %}
allow {{ network }}
{% endfor %}
local stratum {{ chrony_serve_orphan_stratum }} orphan
{% else %}
noclientlog
{% endif %}
