#!/bin/bash
# {"total_mb": N}: 95% of the memory the kernel reports, in MiB, an integer. Read from
# /proc/meminfo: free's labels and awk's decimal separator both follow the locale, and
# either made the fact invalid JSON.
# MEMINFO is the file, for the tests.
total_kb=0
while read -r name value _; do
    if [ "$name" = MemTotal: ]; then
        total_kb="$value"
        break
    fi
done <"${MEMINFO:-/proc/meminfo}"
printf '{"total_mb": %d}\n' "$((total_kb * 95 / 100 / 1024))"
