{{ ansible_managed | comment }}
# Local resolver (roles/dns_resolver): loopback only, used by every process on this
# host through systemd-resolved. unbound.conf(5).
server:
    interface: 127.0.0.1
    access-control: 127.0.0.0/8 allow
    hide-identity: yes
    hide-version: yes
{% if not dns_resolver_dnssec %}
    module-config: "iterator"
{% endif %}
{% for domain in (dns_resolver_blocked_domains + dns_resolver_blocked_domains_site) | map('lower') | unique | sort %}
    local-zone: "{{ domain }}." always_nxdomain
{% endfor %}
{% if dns_resolver_upstreams | length > 0 %}

forward-zone:
    name: "."
{% for address in dns_resolver_upstreams %}
    forward-addr: {{ address }}
{% endfor %}
{% endif %}
