# {{ ansible_managed }}
# The run history's API server (roles/ara_server) for {{ ara_server_user }} alone: a unix
# socket in a directory only they may enter, no TCP port.
[Unit]
Description=ARA run history API server for {{ ara_server_user }} (deepops)
After=network.target

[Service]
User={{ ara_server_user }}
Environment=ARA_BASE_DIR={{ ara_server_base_dir }}
Environment=ARA_SETTINGS={{ ara_server_base_dir }}/settings.yaml
Environment='ARA_DATABASE_OPTIONS=@json {{ ara_server_database_options | to_json }}'
RuntimeDirectory={{ ara_server_runtime_dir }}
RuntimeDirectoryMode=0700
UMask=0077
ExecStart={{ ara_server_venv }}/bin/gunicorn --workers {{ ara_server_workers }} --bind unix:{{ ara_server_socket }} ara.server.wsgi
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths={{ ara_server_base_dir }}

[Install]
WantedBy=multi-user.target
