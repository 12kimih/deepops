[Unit]
Description=Slurm GPU usage report to Slack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart={{ slurm_usage_report_script }} --config {{ slurm_usage_report_config_dir }}/config.json
StateDirectory={{ slurm_usage_report_svc_name }}
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
