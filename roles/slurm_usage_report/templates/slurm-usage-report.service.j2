{{ ansible_managed | comment }}
[Unit]
Description=Cluster {{ item.what }} to Slack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A oneshot has no start timeout by default; one hang would stop its timer for good.
TimeoutStartSec=20min
ExecStart={{ ([_slurm_usage_report_command, '--config', _slurm_usage_report_config] + item.args) | join(' ') }}
StateDirectory={{ _slurm_usage_report_name }}
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
