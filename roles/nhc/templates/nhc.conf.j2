# {{ ansible_managed }}

# Check number of CPU cores
 {{ ansible_facts.hostname }} || check_hw_cpuinfo {{ ansible_facts.ansible_local.topology.cpu_topology.sockets }} {{ ansible_facts.ansible_local.topology.cpu_topology.physical_cores }} {{ ansible_facts.ansible_local.topology.cpu_topology.logical_cpus }}

# Check memory
 {{ ansible_facts.hostname }} || check_hw_physmem {{ (ansible_facts.memtotal_mb * 0.95) | round | int }}m {{ (ansible_facts.memtotal_mb * 1.05) | round | int }}m

# Check that the root filesystem is mounted rw
 {{ ansible_facts.hostname }} || check_fs_mount_rw /

{% if nhc_check_mounts | length > 0 %}
# Check that the shared filesystems are mounted rw. The file test walks into the
# directory first, so a mount a site has put behind an automount is triggered rather
# than reported missing by /proc/mounts on a freshly booted node.
{% for mountpoint in nhc_check_mounts %}
 {{ ansible_facts.hostname }} || check_file_test -d {{ mountpoint }}/.
 {{ ansible_facts.hostname }} || check_fs_mount_rw -f {{ mountpoint }}
{% endfor %}

{% endif %}
# Check that Ethernet connections are up
# (commented out as this detects interfaces that may not need to be online)
{% set my_interfaces = ansible_facts.interfaces|select('match', '(?!^(lo|docker|nodelocaldns)).*')|default(None) -%}
{% for interface in my_interfaces %}
# {{ ansible_facts.hostname }} || check_hw_eth {{ interface }}
{% endfor %}

# Check that the expected services are up. systemd is asked rather than ps: a
# socket-activated sshd has no process until the first login, and a hung systemd
# fails the check instead of leaving a node that can no longer manage services.
{% for units in [ssh_units | join(' '), 'slurmd.service'] %}
 {{ ansible_facts.hostname }} || check_cmd_status -t 10 -r 0 systemctl is-active --quiet {{ units }}
{% endfor %}

{% if ansible_facts.ansible_local.gpus.count > 0 %}
#############################################################################
# GPU-specific checks                                                       #
#############################################################################

# Check GPU count
 {{ ansible_facts.hostname }} || check_nv_gpu_count {{ ansible_facts.ansible_local.gpus.count }}

# Optional: run Data Center GPU Manager diagnostic as health check.
# Requires that DCGM be installed.
# {{ ansible_facts.hostname }} || check_nv_dcgmi_diag

# Optional: check NVIDIA driver version against expected version.
# Use this check to keep all nodes on the cluster at the same driver version
# and control upgrades.
# {{ ansible_facts.hostname }} || check_nv_drv_version 450.51.06

# Optional: check for retired pages pending.
# A reboot may be needed to ensure these pages are blacklisted
# {{ ansible_facts.hostname }} || check_nv_retired_pages

# Optional: check PCIe width is correct for your configuration
# {{ ansible_facts.hostname }} || check_nv_pcie_link_width 16
{% endif %}
