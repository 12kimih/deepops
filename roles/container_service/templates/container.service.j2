{{ ansible_managed | comment }}
[Unit]
Description={{ _container_service.description }}
After=docker.service network-online.target{% for unit in _container_service.after %} {{ unit }}{% endfor %}

Requires=docker.service
Wants=network-online.target
PartOf=docker.service
# Five failed starts in five minutes (RestartSec=10 below) and the unit is failed, which
# the failed-units alert shows, instead of retrying unseen for ever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=10
# No API (dockerd down or its socket gone) fails the start here, plainly.
ExecStartPre=/usr/bin/docker info --format ok
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
ExecStart=/usr/bin/docker run --rm --name %n --label {{ deepops_container_label }}=%n \
{% for option in _container_service.options %}
  {{ option }} \
{% endfor %}
{% for name, value in _container_service.env | dictsort %}
  --env {{ (name ~ '=' ~ value) | systemd_exec_arg }} \
{% endfor %}
{% for mount in _container_service.mounts %}
  --mount type={{ mount.type | default('bind') }},src={{ mount.src }},dst={{ mount.dst }}
{{- ',readonly' if mount.readonly | default(false) else '' }}
{{- (',bind-propagation=' ~ mount.propagation) if mount.propagation | default('') else '' }} \
{% endfor %}
  {{ _container_service.image }}{% for arg in _container_service.args %} \
  {{ arg }}{% endfor %}


[Install]
# PartOf= stops it with docker.service; docker.service starting starts it again.
WantedBy=multi-user.target docker.service
