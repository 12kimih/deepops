# Managed by roles/slurm_backup.
[Unit]
Description=Slurm controller backup: %i
After=mariadb.service
Wants=mariadb.service
# A destination on an NFS mount that is not there would be the bare mount point on the
# local disk: the backup would land there and report success. Mounted first, or no run.
RequiresMountsFor={{ slurm_backup_destinations | map(attribute='path') | join(' ') }}

[Service]
Type=oneshot
ExecStart={{ slurm_backup_script }} %i {{ slurm_backup_config }}
# Behind what people do, yet always moving: the lowest best-effort I/O priority, never
# the idle class, which a busy disk can starve.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Each step is bounded by step_timeout; this bounds the whole run, so a hang the
# program cannot see (a stuck read of a hung mount) still ends and is reported.
TimeoutStartSec={{ slurm_backup_timeout }}
