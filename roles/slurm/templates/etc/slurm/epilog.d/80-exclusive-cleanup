#!/usr/bin/env bash
# Drop the page cache the job left. drop_caches frees clean pages only, so no sync is
# needed first; a sync would also flush NFS and hang the epilog with a hung server.
set -u
. '{{ slurm_config_dir }}/shared/lib/log.sh'

echo 3 > /proc/sys/vm/drop_caches || part_log slurm-exclusive "could not drop caches"
exit 0
