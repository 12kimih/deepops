#!/usr/bin/env bash
set -ex
. '{{ slurm_config_dir }}/shared/lib/log.sh'

# Sibling 40-lastuserjob-processes spares the accounts listed in
# localusers.backup so that operators keep their login session when a job of
# theirs ends. Deleting every file they own under /tmp and /dev/shm undoes that
# from the other side: the session survives but loses the editor swap files,
# sockets and scratch it is holding open. Honour the same exemption.
#
. '{{ slurm_config_dir }}/shared/lib/localusers.sh'
if localusers_spared "$SLURM_JOB_USER"; then
    exit 0  # an operator: their files stay
fi

{% if slurm_epilog_cleanup_scope == 'job' %}
# Job-scoped cleanup (slurm_epilog_cleanup_scope: job).
#
# Files carry a uid, never a job id, so deleting "this job's files" from
# ownership alone is not possible: this script stays per user, and the
# dispatcher only runs it when neither squeue nor the node's cgroups show
# another job of the user.
{% if '/tmp' in slurm_job_private_dirs and '/dev/shm' in slurm_job_private_dirs %}
# Every job has its own /tmp and /dev/shm (slurm_job_private_dirs), removed
# with the job, so this cleanup has nothing to add and would only reach into
# the host's copies.
part_log slurm-epilog \
    "per-job /tmp and /dev/shm are removed with the job, skipping file cleanup"
exit 0
{% endif %}

{% endif %}
if [[ -n "$SLURM_JOB_USER" && "$SLURM_JOB_USER" != "root" ]]; then
    # `find -user` needs the account to resolve. When the directory service is
    # unavailable find exits non-zero without printing anything, and the old
    # `||:` turned that into a silent no-op. Worse, a partial listing would
    # still be piped into `rm -fr`. Resolve the name once, up front, and skip
    # the whole step when it fails: an unresolvable owner is not evidence that
    # nothing is owned.
    if ! id -u -- "$SLURM_JOB_USER" >/dev/null 2>&1; then
        part_log slurm-epilog \
            "cannot resolve ${SLURM_JOB_USER}; skipping file cleanup rather than deleting on a partial listing"
        exit 0
    fi

    for dir in /tmp /dev/shm ; do
        [ -d "$dir" ] || continue

        # -xdev keeps the walk on this filesystem. Without it the walk descends
        # into anything mounted underneath -- a job_container/tmpfs private
        # /tmp, a user sshfs, a bind mount of shared storage -- and deletes
        # files that belong to another node's still-running job.
        #
        # It is not enough on its own, because it bounds the walk and not the
        # deletion that follows:
        #
        #   - a user-owned directory holding a mount is still selected, and
        #     `rm -fr` then descends into the mount the walk refused to enter;
        #   - a user-owned mount root can be selected in its own right, and the
        #     recursive delete empties the mounted filesystem;
        #   - a bind mount from this same filesystem is not a boundary to -xdev
        #     at all, so the walk goes straight in.
        #
        # So the boundary is taken from the kernel's mount table rather than
        # inferred from device numbers. Every mount under $dir is pruned from
        # the walk, and a selected directory that still has one beneath it is
        # left alone. Its siblings are deleted as before, so cleanup continues
        # around a mount instead of stopping at the first one.
        if [ ! -r /proc/self/mountinfo ]; then
            part_log slurm-epilog \
                "cannot read /proc/self/mountinfo; skipping cleanup under ${dir} rather than deleting across an unknown mount boundary"
            continue
        fi

        # Field 5 is the mount point. Spaces, tabs, newlines and backslashes in
        # it are written as octal escapes, which printf %b turns back into the
        # real path. The kernel writes exactly three octal digits (`\040`), but
        # %b reads `\0` followed by up to three digits, so `\0401` -- a space
        # and then a "1" -- would decode as `\001`. Prefixing each escape with
        # a `0` pins the digit count. awk's status is checked for the same
        # reason find's is: an
        # empty mount list reads as "nothing is mounted here", which would put
        # the recursive delete back exactly where it was.
        mountlist=$(mktemp) || continue
        if ! awk '{print $5}' /proc/self/mountinfo >"$mountlist" 2>/dev/null; then
            part_log slurm-epilog \
                "could not read the mount table; skipping cleanup under ${dir}"
            rm -f "$mountlist"
            continue
        fi

        mounts=()
        prune=()
        while IFS= read -r field; do
            printf -v mount_point '%b' "${field//\\/\\0}"
            case "$mount_point" in
                "$dir"/*)
                    mounts+=( "$mount_point" )
                    pattern=${mount_point//\\/\\\\}
                    pattern=${pattern//\*/\\*}
                    pattern=${pattern//\?/\\?}
                    pattern=${pattern//\[/\\[}
                    prune+=( -path "$pattern" -prune -o )
                    ;;
            esac
        done <"$mountlist"
        rm -f "$mountlist"

        # find's exit status is checked instead of being swallowed: a failed or
        # partial walk must not authorise deleting whatever it did manage to
        # list. The listing is materialised first for the same reason; piping
        # straight into xargs hides find's status behind xargs'.
        victims=$(mktemp) || continue
        if find "$dir" -xdev "${prune[@]}" -user "$SLURM_JOB_USER" -print0 >"$victims" 2>/dev/null; then
            while IFS= read -r -d '' victim; do
                nested=""
                # The array-length form would open a Jinja comment in this
                # template and break rendering, so emptiness is tested through
                # the joined elements. A mount point is never an empty string.
                if [ -d "$victim" ] && [ -n "${mounts[*]}" ]; then
                    for mount_point in "${mounts[@]}"; do
                        case "$mount_point" in
                            "$victim"/*) nested="$mount_point" ; break ;;
                        esac
                    done
                fi

                if [ -n "$nested" ]; then
                    part_log slurm-epilog \
                        "leaving ${victim} alone: ${nested} is mounted under it"
                    continue
                fi

                rm -fr -- "$victim" ||:
            done <"$victims"
            part_log slurm-epilog "Removed residual user files under ${dir}"
        else
            part_log slurm-epilog \
                "find failed under ${dir} for ${SLURM_JOB_USER}; leaving it alone"
        fi
        rm -f "$victims"
    done
fi
