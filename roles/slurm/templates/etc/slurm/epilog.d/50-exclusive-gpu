#!/usr/bin/env bash
. '{{ slurm_config_dir }}/shared/lib/log.sh'
# After the one job on the node (run-parts.sh runs *-exclusive-* parts only then): the
# GPUs go back to their default power and clocks. Nothing here kills a process: Slurm
# ends every process of a job itself (proctrack/cgroup, KillWait) and drains a node
# whose processes will not die (UnkillableStepTimeout); a process on a GPU outside any
# job is someone's own, which this part must not end, and the GpuBusyWithoutJob alert
# names it. The inherited "kill every GPU process" step killed other jobs' processes
# on shared nodes (2026-11-23). A failure is logged, never a failed part.
set -u

command -v nvidia-smi >/dev/null || exit 0
timeout 120 '{{ slurm_config_dir }}'/shared/bin/set_gpu_levels.sh default \
    || part_log slurm-epilog "set_gpu_levels.sh default failed"
exit 0
