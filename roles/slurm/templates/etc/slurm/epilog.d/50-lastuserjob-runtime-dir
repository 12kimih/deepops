#!/usr/bin/env bash
# The runtime directory goes with the user's last job on the node (40-all-runtime-dir
# in the prolog makes it). Never across a mount; a failure is logged, not returned: a
# failing epilog drains the node.
set -u
. '{{ slurm_config_dir }}/shared/lib/log.sh'

dir='{{ slurm_user_runtime_root }}'/"$SLURM_JOB_UID"

case "$SLURM_JOB_UID" in
    ''|0|*[!0-9]*) exit 0 ;;
esac
[ -d "$dir" ] && [ ! -L "$dir" ] || exit 0
rm -rf --one-file-system -- "$dir" \
    || part_log slurm-runtime-dir "cannot remove all of $dir"
exit 0
