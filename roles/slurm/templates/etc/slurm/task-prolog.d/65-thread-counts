#!/usr/bin/env bash
# The knobs that size work by the machine, inside a job (user_environment_cpu_knobs,
# roles/user_environment_defaults): threads get each worker's share of the job's CPUs on
# the node, builds the job's CPUs there, from cluster_tools.cpus. Set when the task has
# none or carries the value its login set (CLUSTER_CPUS, CLUSTER_BUILD_JOBS, from
# /etc/profile.d); a value the user chose is left alone.
{% for line in user_environment_cpu_knobs | cpu_knob_lines('prolog', user_environment_cpus_command) %}
{{ line }}
{% endfor %}
