#!/usr/bin/env bash
# The performance CPU governor for a job that has the node to itself (run-parts.sh runs
# *-exclusive-* parts only for Exclusive=NODE). The governor in force before is kept in
# {{ slurm_exclusive_governor_file }} for the epilog to put back: the distribution's
# default (schedutil with intel_cpufreq), never a fixed powersave, which pins a passive
# driver at its lowest frequency. A node without a cpufreq driver, or whose cpupower
# does not match the running kernel, cannot set it; that is logged, never a failed part.
set -u

command -v cpupower >/dev/null || exit 0
governor=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
if [ -r "$governor" ] && [ ! -e '{{ slurm_exclusive_governor_file }}' ]; then
    cat "$governor" > '{{ slurm_exclusive_governor_file }}' 2>/dev/null || :
fi
if ! out=$(timeout 30 cpupower frequency-set -g performance 2>&1); then
    logger -t slurm-exclusive "CPU governor performance not set: $out" || :
fi
exit 0
