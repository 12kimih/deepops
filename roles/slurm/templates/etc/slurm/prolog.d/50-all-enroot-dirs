#!/usr/bin/env bash
# The job user's enroot directories, private to them. Their parents are world-writable
# (so enroot also works outside jobs), which makes every name there anyone's to plant:
# root never creates, chowns or chmods a path in them. Whatever is in the user's place
# and is not their own directory is cleared, and the directory is made by the user.
# Nothing here fails the prolog, which would drain the node: a problem is logged and
# enroot then reports it to that one job.
set -u

command -v enroot >/dev/null || exit 0  # enroot not installed
. '{{ slurm_config_dir }}/shared/lib/enroot-paths.sh' || exit 0

for key in ENROOT_RUNTIME_PATH ENROOT_CACHE_PATH ENROOT_DATA_PATH; do
    path=$(enroot_user_path "$key") || continue
    if [ -e "$path" ] || [ -L "$path" ]; then
        enroot_owned_dir "$path" || enroot_clear "$path" || enroot_log "cannot clear $path"
    fi
    sudo -u "$SLURM_JOB_USER" mkdir -p -m 0700 -- "$path" 2>/dev/null \
        && enroot_owned_dir "$path" \
        && sudo -u "$SLURM_JOB_USER" chmod 0700 -- "$path" \
        || enroot_log "no private $key for $SLURM_JOB_USER at $path"
done
exit 0
