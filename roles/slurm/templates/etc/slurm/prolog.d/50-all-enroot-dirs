#!/usr/bin/env bash
set -ex

command -v enroot >/dev/null || exit 0  # enroot not installed
. '{{ slurm_config_dir }}/shared/lib/enroot-paths.sh'

# Each per-user directory enroot.conf sets, created for the job user, private to them.
# Do not chmod the parent dir: mkdir -p already creates it 0755, and the parent may be a
# shared or systemd-managed path (e.g. /run/user/$UID) we must not relax.
for key in ENROOT_RUNTIME_PATH ENROOT_CACHE_PATH ENROOT_DATA_PATH; do
    path=$(enroot_user_path "$key") || continue
    mkdir -p "$path"
    chown "$SLURM_JOB_UID:$(id -g "$SLURM_JOB_UID")" "$path"
    chmod 0700 "$path"
done
