[Unit]
Description=Prometheus Node Exporter
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
PartOf=docker.service

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
ExecStart=/usr/bin/docker run --rm --network host --pid=host --cpus={{ node_exporter_max_cpu }} --name %n \
  -v /:/host:ro,rslave \
  -v {{ node_exporter_prom_dir }}:{{ node_exporter_prom_dir }}:ro \
{% if 'systemd' in node_exporter_extra_collectors %}
{# Docker's default AppArmor profile blocks D-Bus, which the collector needs. #}
  -v /run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro \
  --security-opt apparmor=unconfined \
{% endif %}
  {{ node_exporter_container }} \
  --path.rootfs=/host \
  --web.listen-address=:{{ node_exporter_port }} \
  --collector.textfile.directory={{ node_exporter_prom_dir }}{% for c in node_exporter_extra_collectors %} \
  --collector.{{ c }}{% endfor %}{% if 'systemd' in node_exporter_extra_collectors %} \
  --collector.systemd.unit-include='{{ node_exporter_systemd_unit_include }}'{% endif %}

[Install]
WantedBy=multi-user.target
