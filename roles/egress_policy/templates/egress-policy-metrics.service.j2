{{ ansible_managed | comment }}
[Unit]
Description=Write users' listening sockets and tunnel programs for node_exporter

[Service]
Type=oneshot
# A oneshot has no start timeout by default; one hang would stop its timer for good.
TimeoutStartSec=50
# The directory may sit on /run, which is empty after a boot.
ExecStartPre=/usr/bin/install -d -m 0755 {{ egress_policy_metrics_textfile_dir }}
ExecStart={{ _egress_policy_metrics_command }} {{ _egress_policy_metrics_config }} {{ egress_policy_metrics_textfile_dir }}/{{ _egress_policy_textfile }}
Nice=10
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
