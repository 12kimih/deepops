# {{ ansible_managed }}
# The users' environment for csh and tcsh (roles/cluster_tools), the same as
# {{ cluster_tools_profile_name }}.sh: each is a DEFAULT, and a value the session already
# carries (set and not empty) is left alone.
{% for e in cluster_tools_profile_entries %}
{% set rest = e.login[2:] if e.login.startswith('~/') else e.login %}
{% set quoted = ('"$HOME"/' if e.login.startswith('~/') else '') ~ "'" ~ (rest | replace("'", "'\"'\"'")) ~ "'" %}
if (! $?{{ e.name }}) setenv {{ e.name }} {{ quoted }}
if ("${{ e.name }}" == "") setenv {{ e.name }} {{ quoted }}
{% endfor %}
{% if user_environment_thread_variables %}
# Thread counts, as in {{ cluster_tools_profile_name }}.sh.
if ( -x {{ user_environment_cpus_command }} ) then
    setenv CLUSTER_CPUS `{{ user_environment_cpus_command }}`
{% for name in user_environment_thread_variables %}
    if (! $?{{ name }}) setenv {{ name }} "$CLUSTER_CPUS"
    if ("${{ name }}" == "") setenv {{ name }} "$CLUSTER_CPUS"
{% endfor %}
endif
{% endif %}
