#!/bin/sh
# {{ ansible_managed }}
# ansible_facts.ansible_local.job_scratch (roles/job_scratch): the size of the job
# directories' filesystem, read on every fact gathering, as slurmd measures TmpFS
# (statvfs), for each node's TmpDisk in slurm.conf (roles/slurm). 0 while unmounted.
size=$(findmnt --bytes --noheadings --output SIZE --mountpoint {{ slurm_job_private_base | quote }} 2>/dev/null)
printf '{"size_mb": %s}\n' "$(( ${size:-0} / 1048576 ))"
