{{ ansible_managed | comment }}
# roles/power_policy: the host's power management at full performance, at boot before
# anything runs a job, and again from its timer. After the GPUs' own boot units (the
# persistence daemon, the power cap), whose settings it checks.
[Unit]
Description=Hold the power management at full performance (deepops)
After=nvidia-persistenced.service {{ nvidia_power_limit_service_name }}
Before=slurmd.service kubelet.service

[Service]
Type=oneshot
# nvidia-smi takes about a second a GPU and setting; each call is bounded itself.
TimeoutStartSec=5min
# The directory may sit on /run, which is empty after a boot.
ExecStartPre=/usr/bin/install -d -m 0755 {{ node_exporter_prom_dir }}
ExecStart={{ power_policy_program }} apply {{ power_policy_conf }}
# Every few minutes: its own lines (what it set) stay in the journal, systemd's start
# and finish lines do not.
SyslogLevel=notice
LogLevelMax=notice

[Install]
WantedBy=multi-user.target
