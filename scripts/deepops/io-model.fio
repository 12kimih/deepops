; One-off measurement for roles/io_fairness (deepops): the iocost model and latency
; targets of the device under /home. Non-destructive: it reads and writes only its own
; 64G scratch file, larger than the RAID controller's cache, 60 s per pattern, O_DIRECT:
; throughput (1M) and IOPS (4k, sequential and random) each way, as iocost's model takes them.
; Run as root on the login node in a quiet hour (scripts/deepops/io_model.py reads the result).
[global]
filename=/home/.io-model-test
size=64G
direct=1
ioengine=libaio
time_based=1
runtime=60
ramp_time=5
group_reporting=1
percentile_list=50:95:99
stonewall

[seq-read]
rw=read
bs=1M
iodepth=64

[seq-write]
rw=write
bs=1M
iodepth=64

[seq-read-4k]
rw=read
bs=4k
iodepth=64

[seq-write-4k]
rw=write
bs=4k
iodepth=64

[rand-read]
rw=randread
bs=4k
iodepth=64

[rand-write]
rw=randwrite
bs=4k
iodepth=64
