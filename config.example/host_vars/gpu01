---
# Example of a host-specific variable file
# These variables would only be used for a host named "gpu01"

# Don't install Singularity on this host
#slurm_cluster_install_singularity: false

# Cap this host's GPUs at 450W (roles/nvidia_power_limit). Hosts without this have any
# cap removed instead, so this is the only place a per-node cap should live.
#nvidia_power_limit_watts: 450
